# Telegram user account (MTProto / Telethon)
TG_API_ID=
TG_API_HASH=
TG_PHONE=
TG_SESSION=runtime/telegram/newsbot

# MAX user account (PyMax). Use the already authorized session from the PoC.
MAX_PHONE=
MAX_SESSION=max.db
MAX_WORK_DIR=runtime/max
MAX_CHANNEL_ID=

# LLM: Groq primary, Mistral fallback
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3-27b
GROQ_MAX_TOKENS=1800
GROQ_TEMPERATURE=0.35
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_MAX_TOKENS=1800
MISTRAL_TEMPERATURE=0.35
LLM_TIMEOUT=90

# News processing
DB_FILE=runtime/news.db
SOURCE_CONFIG=sources.json
AUTO_PUBLISH=1
BACKFILL_LIMIT=100
RETENTION_DAYS=4
POLL_INTERVAL=5
DEDUP_HOURS=36
SIMILARITY_THRESHOLD=0.86
MIN_SOURCES_FOR_HIGH_CONFIDENCE=2

# Editorial policy
LANGUAGE=ru
NEWS_CATEGORIES=politics,svo,russia,world,economy,security
MAX_POST_LENGTH=3500

# Logging
LOG_LEVEL=INFO
MIN_PRIORITY_PUBLISH=70
MIN_CONFIDENCE_PUBLISH=0.82

# LLM protection / fallback
LLM_MIN_INTERVAL_SECONDS=2.0
GROQ_COOLDOWN_SECONDS=30

# Semantic event resolver
# Only recent publishable events enter this self-cleaning window.
EVENT_RESOLVER_HOURS=3
EVENT_RESOLVER_MAX_CANDIDATES=6
EVENT_RESOLVER_SIMILARITY_FLOOR=0.20
EVENT_RESOLVER_CONFIDENCE=0.78
EVENT_RESOLVER_MIN_INTERVAL_SECONDS=4.0
