# ============================================================
# Telegram user account (MTProto / Telethon)
# ============================================================
TG_API_ID=
TG_API_HASH=
TG_PHONE=
TG_SESSION=runtime/telegram/newsbot

# ============================================================
# MAX user account (PyMax)
# ============================================================
MAX_PHONE=
MAX_SESSION=max.db
MAX_WORK_DIR=runtime/max
MAX_CHANNEL_ID=

# ============================================================
# LLM: Groq primary -> Mistral fallback
# ============================================================
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_MAX_TOKENS=1800
GROQ_TEMPERATURE=0.35

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_MAX_TOKENS=1800
MISTRAL_TEMPERATURE=0.35
LLM_TIMEOUT=90

# ============================================================
# News processing
# ============================================================
DB_FILE=runtime/news.db
SOURCE_CONFIG=sources.json

# Live publication is enabled. Startup backfill never publishes.
AUTO_PUBLISH=1

# LLM priority contract: 0..100 in storage; the prompt normally returns 0..10.
# With threshold=3, a normal priority 3..10 live news item can publish.
MIN_PRIORITY_PUBLISH=3
MIN_CONFIDENCE_PUBLISH=0.50

# Startup history: only recent messages inside RETENTION_DAYS are considered.
# They are stored/processed but NEVER published.
BACKFILL_LIMIT=100
RETENTION_DAYS=4

# Safety-net live polling. Telegram NewMessage remains the primary live path.
POLL_INTERVAL=5

# Deduplication
DEDUP_HOURS=36
SIMILARITY_THRESHOLD=0.86
MIN_SOURCES_FOR_HIGH_CONFIDENCE=2

# ============================================================
# Editorial policy
# ============================================================
LANGUAGE=ru
NEWS_CATEGORIES=politics,svo,russia,world,economy,security
MAX_POST_LENGTH=3500

# ============================================================
# Logging / LLM protection
# ============================================================
LOG_LEVEL=INFO
LLM_MIN_INTERVAL_SECONDS=2.0
GROQ_COOLDOWN_SECONDS=30
