import asyncio
import logging

from .config import load_settings
from .logging_setup import setup
from .db import DB
from .core.dedup import find_similar
from .llm.adapter import LLM
from .telegram.collector import TelegramCollector
from .max.publisher import MaxPublisher

log = logging.getLogger("app")


class App:
    def __init__(self):
        self.s = load_settings()
        setup(self.s.log_level)

        self.db = DB(self.s.db_path)

        cutoff = self.db.cleanup_retention(
            self.s.retention_days
        )

        log.info(
            "DB retention cleanup complete retention_days=%s cutoff=%s",
            self.s.retention_days,
            cutoff,
        )

        self.llm = LLM(self.s)
        self.max = MaxPublisher(self.s)

    async def handle_message(
        self,
        msg_id,
        source,
        backfill=False,
    ):
        with self.db.conn() as c:
            row = c.execute(
                "SELECT * FROM messages WHERE id=?",
                (msg_id,),
            ).fetchone()

        if not row:
            log.warning(
                "message not found msg=%s source=%s",
                msg_id,
                source,
            )
            return

        recent = self.db.recent_messages(
            self.s.dedup_hours
        )

        others = [
            r for r in recent
            if r["id"] != msg_id
        ]

        sim = find_similar(
            row["text"],
            others,
            self.s.similarity_threshold,
        )

        if sim:
            existing = self.db.find_event_for_message(
                sim[1]["id"]
            )

            if existing:
                eid = existing["event_id"]

                self.db.attach_event(
                    eid,
                    msg_id,
                )

                try:
                    await self.process_event(
                        eid,
                        allow_publish=not backfill,
                    )
                except Exception:
                    log.exception(
                        "event update failed event=%s",
                        eid,
                    )

                log.info(
                    "dedup -> event=%s source=%s "
                    "similarity=%.3f backfill=%s",
                    eid,
                    row["source"],
                    sim[0],
                    backfill,
                )

                return

        try:
            data = await self.llm.edit(
                [self._source_payload(row)]
            )

            if not data.get("publish"):
                log.info(
                    "editor rejected msg=%s reason=%s backfill=%s",
                    msg_id,
                    data.get("reason"),
                    backfill,
                )
                return

            try:
                priority = int(
                    data.get("priority", 0)
                )
            except (TypeError, ValueError):
                priority = 0

            try:
                confidence = float(
                    data.get("confidence", 0)
                )
            except (TypeError, ValueError):
                confidence = 0.0

            eid = self.db.create_event(
                data.get("title", ""),
                data.get("category", "other"),
                priority,
                confidence,
                msg_id,
            )

            self.db.set_article(
                eid,
                data.get("title", ""),
                data.get("text", ""),
                data.get("category", "other"),
                confidence,
                data.get("reason", ""),
            )

            log.info(
                "article ready event=%s priority=%s "
                "confidence=%.2f publish=%s backfill=%s",
                eid,
                priority,
                confidence,
                data.get("publish"),
                backfill,
            )

            if backfill:
                log.info(
                    "publish SKIP event=%s "
                    "reason=startup_backfill",
                    eid,
                )
            else:
                await self.maybe_publish(
                    eid,
                    data,
                )

        except Exception:
            log.exception(
                "processing failed msg=%s",
                msg_id,
            )

    def _source_payload(self, row):
        return {
            "source": row["source"],
            "url": row["url"],
            "text": row["text"],
            "reliability": row["source_reliability"],
            "priority": row["source_priority"],
        }

    async def process_event(
        self,
        eid,
        allow_publish=True,
    ):
        rows = self.db.event_messages(eid)

        if not rows:
            log.warning(
                "event has no messages event=%s",
                eid,
            )
            return

        data = await self.llm.edit(
            [
                self._source_payload(r)
                for r in rows
            ]
        )

        if not data.get("publish"):
            self.db.mark_rejected(
                eid,
                data.get("reason", ""),
            )

            log.info(
                "event rejected event=%s reason=%s",
                eid,
                data.get("reason", ""),
            )

            return

        try:
            priority = int(
                data.get("priority", 0)
            )
        except (TypeError, ValueError):
            priority = 0

        try:
            confidence = float(
                data.get("confidence", 0)
            )
        except (TypeError, ValueError):
            confidence = 0.0

        self.db.update_event(
            eid,
            data.get("title", ""),
            data.get("category", "other"),
            priority,
            confidence,
        )

        self.db.set_article(
            eid,
            data.get("title", ""),
            data.get("text", ""),
            data.get("category", "other"),
            confidence,
            data.get("reason", ""),
        )

        log.info(
            "article updated event=%s priority=%s "
            "confidence=%.2f publish=%s allow_publish=%s",
            eid,
            priority,
            confidence,
            data.get("publish"),
            allow_publish,
        )

        if allow_publish:
            await self.maybe_publish(
                eid,
                data,
            )
        else:
            log.info(
                "publish SKIP event=%s "
                "reason=startup_backfill",
                eid,
            )

    async def maybe_publish(
        self,
        eid,
        data,
    ):
        """
        Автопубликация LIVE-новостей.

        Текущий контракт LLM:
            priority   = 0..10
            confidence = 0..1
            publish    = bool

        Для совместимости со старым .env:
            MIN_PRIORITY_PUBLISH=70
        автоматически нормализуется в:
            7

        Важно:
            startup-backfill сюда не должен попадать.
            Backfill блокируется выше через allow_publish=False.
        """

        if not self.s.auto_publish:
            log.info(
                "publish SKIP event=%s "
                "reason=AUTO_PUBLISH=0",
                eid,
            )
            return

        try:
            priority = int(
                data.get("priority", 0)
            )
        except (TypeError, ValueError):
            priority = 0

        try:
            confidence = float(
                data.get("confidence", 0)
            )
        except (TypeError, ValueError):
            confidence = 0.0

        publish_flag = bool(
            data.get("publish")
        )

        configured_threshold = int(
            self.s.min_priority_publish
        )

        # Current LLM priority scale is 0..10.
        #
        # Older configurations could contain:
        #   MIN_PRIORITY_PUBLISH=70
        #
        # Treat that as priority 7.
        if configured_threshold > 10:
            threshold = round(
                configured_threshold / 10
            )

            threshold = max(
                0,
                min(10, threshold),
            )

            log.warning(
                "publish priority config uses "
                "legacy 0..100 scale: "
                "configured=%s normalized=%s",
                configured_threshold,
                threshold,
            )
        else:
            threshold = max(
                0,
                min(10, configured_threshold),
            )

        if not publish_flag:
            log.info(
                "publish SKIP event=%s "
                "reason=LLM_publish_false",
                eid,
            )
            return

        if priority < threshold:
            log.info(
                "publish SKIP event=%s "
                "reason=priority "
                "priority=%s threshold=%s",
                eid,
                priority,
                threshold,
            )
            return

        if confidence < self.s.min_confidence_publish:
            log.info(
                "publish SKIP event=%s "
                "reason=confidence "
                "confidence=%.2f threshold=%.2f",
                eid,
                confidence,
                self.s.min_confidence_publish,
            )
            return

        log.info(
            "MAX publish START event=%s "
            "priority=%s confidence=%.2f",
            eid,
            priority,
            confidence,
        )

        await self.publish_event(
            eid
        )

    async def publish_event(
        self,
        eid,
    ):
        with self.db.conn() as c:
            article = c.execute(
                "SELECT * FROM articles "
                "WHERE event_id=?",
                (eid,),
            ).fetchone()

            message = c.execute(
                "SELECT m.* "
                "FROM messages m "
                "JOIN event_messages em "
                "ON em.message_id=m.id "
                "WHERE em.event_id=? "
                "ORDER BY m.created_at "
                "LIMIT 1",
                (eid,),
            ).fetchone()

        if not article:
            log.error(
                "MAX publish failed event=%s "
                "reason=article_not_found",
                eid,
            )
            return

        try:
            maxid = await self.max.publish(
                article["title"],
                article["text"],
                "",
            )

            self.db.mark_published(
                eid,
                maxid,
            )

            log.info(
                "MAX publish SUCCESS "
                "event=%s max_message_id=%s",
                eid,
                maxid,
            )

        except Exception:
            log.exception(
                "MAX publish FAILED event=%s",
                eid,
            )
            raise

    async def start_max_safe(self):
        try:
            await self.max.start()

        except Exception:
            log.exception(
                "MAX startup failed; "
                "Telegram processing will continue"
            )

    async def run(self):
        collector = TelegramCollector(
            self.s,
            self.db,
            self.handle_message,
        )

        try:
            await asyncio.gather(
                self.start_max_safe(),
                collector.start(),
            )

        except asyncio.CancelledError:
            log.info(
                "App shutdown requested"
            )
            raise